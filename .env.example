# Copie para .env e substitua TODOS os valores. Nunca versione o .env.
# Valores abaixo são demonstrativos e inseguros de propósito.

# --- Aplicação ---
APP_ENV=development            # development | staging | production
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-valor-aleatorio-longo
FRONTEND_ORIGIN=http://localhost:5173   # única origem aceita por CORS e WebSocket
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90
LOG_LEVEL=INFO

# --- Banco de dados ---
POSTGRES_DB=boardhub
POSTGRES_USER=boardhub_app
POSTGRES_PASSWORD=troque-esta-senha
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5432              # porta no host (publicada só em 127.0.0.1)

# --- E-mail transacional (desenvolvimento: servidor SMTP local de testes) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=nao-responda@example.test

# --- IA ---
CHESS_ENGINE_PATH=             # caminho do binário UCI; vazio = busca própria (mais fraca)
AI_MAX_CONCURRENT=2
OLLAMA_ENABLED=false           # opcional; o produto funciona sem ele
OLLAMA_URL=http://ollama:11434 # somente rede interna
OLLAMA_MODEL=                  # a definir (P-09)
OLLAMA_TIMEOUT_SECONDS=4
